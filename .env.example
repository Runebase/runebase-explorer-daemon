# Chain
CHAIN=mainnet

# Database
DB_NAME=runebase_explorer
DB_USER=runebase_explorer
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# RPC (Runebase Core: runebased or runebase-qt)
# Port: mainnet 9432, testnet 19432
# User/pass must match rpcuser/rpcpassword in ~/.runebase/runebase.conf
RPC_PROTOCOL=http
RPC_HOST=localhost
RPC_PORT=9432
RPC_USER=runebase_explorer
RPC_PASS=runebase_explorer

# P2P (the node's peer port): mainnet 9947, testnet 19947
P2P_PORT=9947

# Server (Socket.IO)
SERVER_PORT=3001
