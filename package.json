{
  "name": "runebase-explorer-daemon",
  "private": true,
  "version": "0.1.4",
  "description": "Blockchain indexer for the Runebase network",
  "main": "src/index.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && babel src --out-dir dist --copy-files --keep-file-extension",
    "start": "node --experimental-specifier-resolution=node dist/index.mjs start",
    "dev": "nodemon --exec node src/index.mjs start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "release:patch": "npm version patch -m 'chore(release): bump to v%s' && npm run build && git add dist/ && git commit -m \"chore(build): release\" --no-verify",
    "release:minor": "npm version minor -m 'chore(release): bump to v%s' && npm run build && git add dist/ && git commit -m \"chore(build): release\" --no-verify",
    "release:major": "npm version major -m 'chore(release): bump to v%s' && npm run build && git add dist/ && git commit -m \"chore(build): release\" --no-verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runebase/runebase-explorer-daemon.git"
  },
  "keywords": [
    "runebase",
    "runebase-explorer-daemon",
    "runebase explorer"
  ],
  "author": "RUNEBASE <foundation@runebase.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/runebase/runebase-explorer-daemon/issues"
  },
  "homepage": "https://github.com/runebase/runebase-explorer-daemon#readme",
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.2"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ethereumjs-abi": "^0.6.8",
    "lru-cache": "^11.5.2",
    "mysql2": "^3.24.2",
    "secp256k1": "^5.0.2",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2"
  }
}
